+_RETIRED_DATABASES: list[str] = []
+"""Throwaway databases awaiting disposal at the end of the session.
+
+Dropping each one as its test finished is what caused the ``tuple concurrently
+updated`` / ``tuple concurrently deleted`` flake: a ``DROP DATABASE`` ran while
+the next test was creating its own database and applying the migration chain,
+and the two collided on catalogs shared across the whole cluster.
+
+Measured 2026-08-20 on an isolated cluster carrying no other workload — 4 of 6
+runs of one test file failed with per-test drops enabled, 0 of 6 with them
+deferred, and 0 of 10 when each test ran in its own process (which removes the
+same overlap a different way).
+
+Deferring disposal removes the overlap rather than tolerating it: nothing is
+dropped while any test is running. Per-test isolation is unchanged — every test
+still gets its own freshly created, genuinely empty database.
+"""
+
+
+def _release_background_workers(db_name: str) -> None:
+    """Delete a throwaway database's TimescaleDB jobs before retiring it.
+
+    Deferring ``DROP DATABASE`` to the end of the session (see
+    ``_RETIRED_DATABASES``) leaves every retired database alive and still
+    carrying its continuous-aggregate policies. TimescaleDB keeps a background
+    worker for each such database, and the budget is small — measured
+    2026-08-21, an integration run reached 13 live databases against
+    ``timescaledb.max_background_workers = 8``. The result was that
+    ``test_policy_advances_head.py`` never got a worker, so its policy never
+    ran: 9/9 passing alone, failing in a full run.
+
+    Removing the jobs costs one statement and drops the database's worker
+    demand to zero while its shell waits for disposal.
+    """
+    url = swap_dbname(TEST_ADMIN_URL, db_name)
+    try:
+        with psycopg.connect(url, autocommit=True) as conn:
+            conn.execute(
+                "SELECT delete_job(job_id) FROM timescaledb_information.jobs "
+                "WHERE job_id >= 1000"
+            )
+    except psycopg.Error:
+        # Swallowed deliberately: the database has no TimescaleDB extension, or
+        # is already unreachable. Either way it is about to be discarded, and
+        # the only cost of not clearing its jobs is one background worker held
+        # until the end of the session. Failing teardown here would turn a
+        # cosmetic problem into a failed test.
+        pass
+
+
+def _drop_databases(names: list[str]) -> None:
+    """Drop throwaway databases, tolerating any already gone.
+
+    Only ever called with names generated by this module (``mt_test_*``), and
+    only against ``MT_TIMESCALE_TEST_URL``, which is separate from the
+    production variable by design.
+    """
+    if not names or not TEST_ADMIN_URL:
+        return
+    with psycopg.connect(TEST_ADMIN_URL, autocommit=True) as admin:
+        for db_name in names:
+            # Terminate live connections so DROP DATABASE doesn't block.
+            # Skip superuser backends: pg_signal_backend does not permit
+            # signalling them ("Only roles with the SUPERUSER attribute may
+            # terminate processes of roles with the SUPERUSER attribute"), and
+            # the test-admin credential is deliberately not a superuser. A
+            # superuser connected to a throwaway database is an operator looking
+            # at it, not something the suite should be killing.
+            admin.execute(
+                "SELECT pg_terminate_backend(a.pid) FROM pg_stat_activity a "
+                "JOIN pg_roles r ON r.rolname = a.usename "
+                "WHERE a.datname = %s AND a.pid <> pg_backend_pid() "
+                "AND NOT r.rolsuper",
+                (db_name,),
+            )
+            admin.execute(f'DROP DATABASE IF EXISTS "{db_name}"')
+
+
+@pytest.fixture(scope="session", autouse=True)
+def _dispose_of_throwaway_databases() -> Iterator[None]:
+    """Sweep stale databases at session start; drop this session's at the end.
+
+    The opening sweep matters precisely because disposal is deferred: an
+    interrupted run (Ctrl-C, a crash, a killed CI job) leaves its databases
+    behind, and without a sweep they would accumulate unnoticed. It removes only
+    ``mt_test_*`` names, which nothing but this module creates.
+    """
+    if TEST_ADMIN_URL:
+        with psycopg.connect(TEST_ADMIN_URL, autocommit=True) as admin:
+            stale = [
+                row[0]
+                for row in admin.execute(
+                    "SELECT datname FROM pg_database "
+                    "WHERE datname LIKE 'mt\\_test\\_%' AND NOT datistemplate"
+                ).fetchall()
+            ]
+        _drop_databases(stale)
+
+    yield
+
+    pending, _RETIRED_DATABASES[:] = list(_RETIRED_DATABASES), []
+    _drop_databases(pending)
+
+
