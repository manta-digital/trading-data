            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Data serving API for OHLCV bars, symbol metadata, and gap status.",
    "title": "Manta Trading API",
    "version": "0.7.4"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/bars/{symbol}": {
      "get": {
        "description": "Return OHLCV bars for ``symbol`` over the requested date range.\n\nFor a cagg-served granularity the response carries ``is_stale``, probed\nagainst the exact view the bars came from (slice 185 D7). ``M1``/``D1`` read\nraw hypertables, so no probe is issued and ``is_stale`` is always ``False``.\n\nWindows are admitted before any database work (186 D4): a reversed range or\none whose estimated bar count exceeds the configured ceiling is a ``422``,\nnot a slow ``500``.",
        "operationId": "get_bars_api_v1_bars__symbol__get",
        "parameters": [
          {
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "title": "Symbol",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "granularity",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Granularity"
            }
          },
          {
            "in": "query",
            "name": "start",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Start",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "end",
            "required": true,
            "schema": {
              "format": "date",
              "title": "End",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "adjusted",
            "required": false,
            "schema": {
              "default": true,
              "title": "Adjusted",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "json",
              "enum": [
                "json",
                "msgpack"
              ],
              "title": "Format",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The database cancelled the query at the server's statement timeout. Narrow the requested range or use a coarser granularity."
          }
        },
        "summary": "Get Bars"
      }
    },
    "/api/v1/gaps/{symbol}": {
      "get": {
        "description": "Return data gaps for ``symbol``, filtered by granularity and date window.",
        "operationId": "get_gaps_api_v1_gaps__symbol__get",
        "parameters": [
          {
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "title": "Symbol",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "granularity",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Granularity"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Granularity"
            }
          },
          {
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "in": "query",
            "name": "end",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GapsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The database cancelled the query at the server's statement timeout. Narrow the requested range or use a coarser granularity."
          }
        },
        "summary": "Get Gaps"
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Liveness/readiness probe.\n\nReturns HTTP 200 in both healthy and DB-error cases \u2014 callers\ndistinguish DB state via the ``db`` field of the response body.\n\n``coverage`` is a coarse pipeline-health signal: exactly the two coverage\ncaggs behind ``data_status`` (slice 185 D6), not a probe of all seven\nbar-serving caggs. Per-granularity truth belongs to the bars endpoint's own\n``is_stale`` field.\n\nDeliberately a **sync** handler: FastAPI runs sync routes in a worker\nthread, so the blocking freshness probe needs no ``run_in_executor``.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v1/status": {
      "get": {
        "description": "Return ``data_status`` health rows plus coverage-cagg freshness.\n\nAn unknown or non-matching ``symbol`` is a 200 with ``rows: []`` (D5) \u2014\n``scope`` still reports ``\"symbol\"`` so a client can tell \"filtered scope,\nnothing matched\" from \"whole registry\".\n\nDB failures are not caught here (D9): the freshness probes never raise (a\nfailed probe is a stale verdict), and a genuine ``data_status`` query\nfailure propagates to the global 500 handler in ``app.py``.",
        "operationId": "get_status_api_v1_status_get",
        "parameters": [
          {
            "in": "query",
            "name": "symbol",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Symbol"
            }
          },
          {
            "in": "query",
            "name": "health",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Health"
            }
          },
          {
            "in": "query",
            "name": "granularity",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "daily",
                    "minute"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Granularity"
            }
          },
          {
            "in": "query",
            "name": "all",
            "required": false,
            "schema": {
              "default": false,
              "title": "All",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The database cancelled the query at the server's statement timeout. Narrow the requested range or use a coarser granularity."
          }
        },
        "summary": "Get Status"
      }
    },
    "/api/v1/symbols": {
      "get": {
        "description": "Return instruments matching an optional prefix search.",
        "operationId": "list_symbols_api_v1_symbols_get",
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Search"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SymbolsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The database cancelled the query at the server's statement timeout. Narrow the requested range or use a coarser granularity."
          }
        },
        "summary": "List Symbols"
      }
    },
    "/api/v1/symbols/{symbol}": {
      "get": {
        "description": "Return full metadata and available data ranges for a single symbol.",
        "operationId": "get_symbol_api_v1_symbols__symbol__get",
