# /etc/cron.d/manta-trading-backup — the backup tier's schedule (slice 920 D7, slice 227).
#
# RENDERED BY deploy/setup-backup.sh FROM deploy/cron.d/manta-trading-backup
# (host block) AND deploy/cron.d/manta-trading-backup.cluster (one block per
# row of deploy/backup-clusters.conf, each opened by a `# cluster <name>` line).
# Do not edit here: change the template or the script's constants and re-run
# `sudo deploy/setup-backup.sh`. `--check` reports DRIFT if this file differs
# from a fresh render. Every at-sign-delimited token is substituted by the script; the
# push schedule, --stale-after (3 x interval), and --timeout (interval - 1)
# are all derived from one constant, WAL_OFFSITE_INTERVAL_MIN.
#
# No mail transport on this host: every job redirects its output to a log
# under the backup root, and the health check turns failures into flag files.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# m h dom mon dow  user  command
@CLUSTER_BLOCKS@
# host: system backup (restic), once per host
0 4 * * * root @CHECKOUT@/scripts/cron_system_backup.sh --env-file @ENV_FILE@ --repo-prefix @RESTIC_PREFIX@ --exclude-file @CHECKOUT@/deploy/restic-excludes.txt --stamp @HOST_ROOT@/system-backup.stamp --log @HOST_ROOT@/system-backup.log --lock @HOST_ROOT@/system-backup.lock >/dev/null 2>&1
0 5 1 * * root @CHECKOUT@/scripts/cron_system_backup.sh --check --env-file @ENV_FILE@ --repo-prefix @RESTIC_PREFIX@ --log @HOST_ROOT@/system-backup.log --lock @HOST_ROOT@/system-backup.lock >/dev/null 2>&1
