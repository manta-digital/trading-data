# /etc/manta-trading.env — runtime environment for the mt-* systemd units.
#
# Installed by deploy/install-production.sh only if absent; never overwritten.
# Fill the real values with `sudoedit /etc/manta-trading.env`.
# Required mode/owner: 0640 root:manta-trading (the install script re-asserts).
#
# MT_TIMESCALE_MAINTENANCE_URL is deliberately ABSENT: the DDL credential
# stays out of service environments (slice 913 credential separation).
# Migrations remain an operator action from an interactive shell.

# DML-only application credential.
MT_TIMESCALE_DB_URL=postgresql://PLACEHOLDER_USER:PLACEHOLDER_PASSWORD@localhost:5432/PLACEHOLDER_DB

MT_EODHD_API_KEY=PLACEHOLDER_EODHD_API_KEY

# Optional operator tuning:
#MT_LOG_LEVEL=INFO
#MT_DAILY_CYCLE_RETRY_MINUTES=30
#MT_KALSHI_REQUESTS_PER_MINUTE=300          # lower to ease 429s on /events (public tier)
#MT_KALSHI_API_KEY_ID=                      # authenticated mode: both or neither
#MT_KALSHI_PRIVATE_KEY_PATH=/etc/manta-trading-kalshi.pem   # 0640 root:manta-trading; never under /home (ProtectHome)
