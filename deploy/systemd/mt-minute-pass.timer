[Unit]
Description=Fire the minute acquisition pass (daily, after EODHD publishes)
Documentation=https://github.com/manta-digital/trading-data

[Timer]
# One firing a day, 13:05 UTC: after EODHD has published the previous
# session (measured: not by 05:35 UTC, present by 11:27; #22) and 30 minutes
# behind the 12:35 daily pass so the two never start simultaneously (both
# draw on the same provider quota). Held in MINUTE_PASS_FIRING_TIMES_UTC; a
# drift-guard test compares.
OnCalendar=*-*-* 13:05:00 UTC
# Fire a schedule missed while the host was down (post-reboot catch-up).
Persistent=true

[Install]
WantedBy=timers.target
