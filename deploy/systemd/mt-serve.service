[Unit]
Description=Manta Trading API server (mt serve)
Documentation=https://github.com/manta-digital/trading-data
After=network-online.target
Wants=network-online.target
# Give up only after 5 failed starts within 5 minutes.
StartLimitBurst=5
StartLimitIntervalSec=300s

[Service]
Type=simple
User=manta-trading
Group=manta-trading
WorkingDirectory=/opt/manta-trading
EnvironmentFile=/etc/manta-trading.env
# The venv entry point directly — uv is a deploy-time tool, not a runtime
# dependency; `uv run` at service start could resolve/sync at the wrong moment.
ExecStart=/opt/manta-trading/.venv/bin/mt serve
Restart=on-failure
RestartSec=10s
# Journald is the log sink — no application-level log files.
StandardOutput=journal
StandardError=journal
# Hardening: minimal additional surface beyond the service user.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
