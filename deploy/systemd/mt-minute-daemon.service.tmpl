[Unit]
Description=Manta Trading minute acquisition daemon (slice 128)
Documentation=https://github.com/manta-trading/trading
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${MANTA_TRADING_SERVICE_USER}
Group=${MANTA_TRADING_SERVICE_USER}
WorkingDirectory=/opt/manta-trading
EnvironmentFile=/etc/manta-trading.env
# uv-based invocation. Repo's uv.lock pins everything.
ExecStart=/usr/local/bin/uv run mt data daemon run --minute
Restart=on-failure
RestartSec=10s
StartLimitBurst=5
StartLimitIntervalSec=300s
# Journald is the log sink — no application-level log files.
StandardOutput=journal
StandardError=journal
# Hardening: minimal additional surface beyond the service user.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
