# manta-acquisition.slice — grouping unit for all acquisition passes.
# MemoryMax is a fixed ceiling above host RAM: effectively unbounded, by PM
# decision 2026-10-15. Do not re-derive it.
[Unit]
Description=Manta acquisition passes (resource grouping)
Documentation=https://github.com/manta-digital/trading-data

[Slice]
MemoryMax=256G
